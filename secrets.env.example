# Copy to secrets.env (git-ignored) and fill in. Do NOT commit the real file.

# HotSchedules login
HS_USERNAME=your.username
HS_PASSWORD=your.password

# Discord DM delivery (new dedicated bot)
# - Create a bot at https://discord.com/developers/applications, copy its token.
# - Invite the bot to a server you ALSO belong to (required for it to DM you).
# - DISCORD_RECIPIENT_ID is YOUR Discord user ID (enable Developer Mode ->
#   right-click your name -> Copy User ID).
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_RECIPIENT_ID=your-discord-user-id

# Optional overrides
# HS_STORE_TZ=America/Chicago
# UPLOADER_BASE_URL=https://files.example.com

# Delivery toggles (defaults shown). Values: true/false (also 1/0, yes/no, on/off).
# IMPORTANT: no inline comments — put any comment on its own line. systemd's
# EnvironmentFile treats everything after '=' as the value.
# PUBLISH_ENABLED  -> upload the PDF to the file host (needed for a link)
# DM_INCLUDE_LINK  -> show the hosted link in the DM text
# DM_ATTACH_PDF    -> attach the PDF file to the DM
# PUBLISH_ENABLED=true
# DM_INCLUDE_LINK=true
# DM_ATTACH_PDF=true
