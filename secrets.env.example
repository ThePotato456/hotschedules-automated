# Copy to secrets.env (git-ignored) and fill in. Do NOT commit the real file.

# HotSchedules login
HS_USERNAME=your.username
HS_PASSWORD=your.password

# Discord DM delivery (new dedicated bot)
# - Create a bot at https://discord.com/developers/applications, copy its token.
# - Invite the bot to a server you ALSO belong to (required for it to DM you).
# - DISCORD_RECIPIENT_ID is YOUR Discord user ID (enable Developer Mode ->
#   right-click your name -> Copy User ID).
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_RECIPIENT_ID=your-discord-user-id

# Optional overrides
# HS_STORE_TZ=America/Chicago
# UPLOADER_BASE_URL=https://files.example.com

# Delivery toggles (defaults shown). Values: true/false (also 1/0, yes/no, on/off).
# IMPORTANT: no inline comments — put any comment on its own line. systemd's
# EnvironmentFile treats everything after '=' as the value.
# PUBLISH_ENABLED  -> upload to the file host when no print server is configured
# DM_INCLUDE_LINK  -> show that legacy file-host link in the DM text
# DM_ATTACH_PDF    -> attach the PDF file to the DM
# PUBLISH_ENABLED=true
# DM_INCLUDE_LINK=true
# DM_ATTACH_PDF=true

# Cached roster print server (optional). Generate a token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ROSTER_WEB_TOKEN=replace-with-a-random-url-safe-token-at-least-32-characters
# Caddy terminates HTTPS and preserves /roster; Python binds to loopback.
# ROSTER_WEB_PUBLIC_URL=https://example.com/roster
# Configuring both URL and token makes Discord link to /roster/YYYY-MM-DD/TOKEN/.
# The print button uses that day's /pdf endpoint. Public uploads are skipped.
# Browse all retained dates at /roster/all/TOKEN/.
# Bookmark /roster/today/TOKEN/ for the current store-local day's roster.
# ROSTER_WEB_HOST=127.0.0.1
# ROSTER_WEB_PORT=3010
# ROSTER_CACHE_DIR=var/rosters
# ROSTER_READY_TIME=07:45
# APPLE_SHORTCUT_NAME=PrintPDF
