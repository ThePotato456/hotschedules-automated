[Unit]
Description=HotSchedules daily roster -> publish + Discord DM
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APPDIR@
EnvironmentFile=@APPDIR@/secrets.env
Environment=PLAYWRIGHT_BROWSERS_PATH=@APPDIR@/.playwright
ExecStart=@APPDIR@/.venv/bin/python -m hs_roster.main
# Don't hang the timer forever if the network or render stalls.
TimeoutStartSec=300

# Light hardening (chromium needs a writable tmp + /dev/shm).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
